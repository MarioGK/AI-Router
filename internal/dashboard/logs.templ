package dashboard

import "strconv"

const (
	// logStream follows the log for the current filters; any change to them
	// or to the pause restarts it, and it reconnects after the router
	// restarts.
	logStream = "$model; $status; $search; $paused; @get('/dashboard/sse/logs', {retry: 'always', retryMaxCount: 100})"
	// logLive words the stream's state.
	logLive = "$paused ? 'Paused' : $_live ? 'Live' : 'Offline'"
)

// logFilter resumes a paused log when a filter changes.
var logFilter = templ.Attributes{"data-on:change": "$paused = false"}

templ logsPage(f frame, q logQuery, v requestTable, models []string, deleted, problem string) {
	@shell(f) {
		<div data-signals={ signals(map[string]any{"model": q.Model, "status": q.Status, "paused": false, "search": q.Search, "searchDraft": q.Search}) }>
			@heading("Logs", "Every auto request, live") {
				<div class="flex flex-wrap items-center gap-2">
					@promptSearch("logs-search", q.Search, "$search = $searchDraft; $paused = false", "$search = ''; $searchDraft = ''; $paused = false")
					@choice("model", "All models", q.Model, modelOptions(models), logFilter)
					@choice("status", "All statuses", q.Status, outcomes, logFilter)
					<button
						type="button"
						aria-pressed="false"
						data-attr:aria-pressed="$paused ? 'true' : 'false'"
						data-on:click="$paused = !$paused"
						class="flex h-8 items-center gap-2 rounded-md border border-line bg-surface px-3 text-[13px] font-medium hover:border-line-strong"
					>
						<span data-show="!$paused">
							@icon("pause", "size-3.5")
						</span>
						<span data-show="$paused" style="display: none">
							@icon("play", "size-3.5")
						</span>
						<span data-text="$paused ? 'Resume' : 'Pause'">Pause</span>
					</button>
				</div>
			}
			if deleted != "" {
				<p role="status" class="mb-4 rounded-lg border border-good/30 bg-good/5 p-3 text-[13px] text-good">Deleted { deleted } request logs. Pins and decisions were kept.</p>
			}
			if problem != "" {
				<p role="alert" class="mb-4 rounded-lg border border-critical/30 bg-critical/5 p-3 text-[13px] text-critical">{ problem }</p>
			}
			<section id="log" class="overflow-hidden rounded-xl border border-line bg-surface" data-indicator:_live data-effect={ logStream }>
				<div class="flex items-center justify-between gap-3 border-b border-line px-5 py-3">
					@livePill(logLive)
					<span class="text-xs text-fg-3">The latest { strconv.Itoa(tailSize) } matching requests</span>
				</div>
				<div class="overflow-x-auto">
					<table class="block w-full text-left text-[13px] md:table">
						@requestHead(logColumns)
						@logRows(v)
					</table>
				</div>
			</section>
			@deleteLogsForm(q)
		</div>
	}
}

templ logRows(v requestTable) {
	@requestRows("log-rows", v, logColumns, "No request matches these filters yet; new ones show up live.")
}


templ deleteLogsForm(q logQuery) {
	<details class="mt-6 rounded-xl border border-line bg-surface p-4">
		<summary class="cursor-pointer text-[13px] font-medium">Delete request logs</summary>
		<p class="mt-3 max-w-2xl text-xs leading-relaxed text-fg-3">Permanently removes request logs across all models, regardless of the filters above. Usage totals, cost history and learned task-cost estimates will lose these requests. Pinned threads, decision prompts and reviews are kept.</p>
		<form action="/dashboard/logs/delete" method="post" class="mt-4 space-y-3">
			<input type="hidden" name="model" value={ q.Model } data-attr:value="$model"/>
			<input type="hidden" name="status" value={ q.Status } data-attr:value="$status"/>
			<input type="hidden" name="search" value={ q.Search } data-attr:value="$search"/>
			<div class="flex flex-wrap items-center gap-2">
				<label for="delete-age" class="text-[13px] text-fg-2">Delete logs</label>
				<select id="delete-age" name="age" class="h-9 rounded-md border border-line bg-canvas py-1 pr-8 pl-3 text-[13px]">
					<option value="30d">Older than 30 days</option>
					<option value="7d">Older than 7 days</option>
					<option value="24h">Older than 24 hours</option>
					<option value="all">All existing request logs</option>
				</select>
			</div>
			<label class="flex items-center gap-2 text-[13px] text-fg-2"><input type="checkbox" name="confirm" value="delete" required class="size-4"/> I understand these request logs will be permanently deleted.</label>
			<button type="submit" class="h-9 rounded-md border border-critical/40 bg-critical/5 px-3 text-[13px] font-medium text-critical hover:bg-critical/10">Delete selected logs</button>
		</form>
	</details>
}
