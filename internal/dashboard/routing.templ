package dashboard

import (
	"slices"
	"strconv"
	"strings"

	"github.com/MarioGK/AI-Router/internal/decide"
	"github.com/MarioGK/AI-Router/internal/route"
)

templ routingPage(f frame, v routingView) {
	@shell(f) {
		@heading("Routing for "+v.ModelID, "Choose your models and preferences. Save changes anytime, without a deploy. Explicit model requests keep their own route.")
		<div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_18rem]">
			<form method="post" action="/dashboard/routing" class="routing-editor min-w-0 space-y-5">
				if v.Saved {
					<p class="flex items-center gap-2 rounded-xl border border-good/30 bg-good/10 px-5 py-3 text-[13px]" role="status">@icon("check", "size-4 text-good")
Routing settings saved. Your changes are active.</p>
				}
				if v.Problem != "" {
					<p id="routing-problem" class="rounded-xl border border-critical/40 bg-critical/10 px-5 py-3 text-[13px]" role="alert">{ v.Problem }</p>
				}
				<fieldset disabled?={ !v.Available } class="space-y-5">
					<legend class="sr-only">Routing settings</legend>
					<section class="rounded-xl border border-line bg-surface p-5 sm:p-6" aria-labelledby="routing-mode-title">
						<div class="mb-4 flex items-center gap-2">
							<span class="grid size-6 place-items-center rounded-full bg-raised text-xs text-fg-3">1</span>
							<h2 id="routing-mode-title" class="font-semibold">How should requests be routed?</h2>
							@routingHelp("routing-mode-help", "Routing mode", "Automatic lets Jev choose a suitable enabled model and keeps a thread on that model. Use one model bypasses every decider and temporarily overrides existing pins. Saved automatic pins return when you switch back.")
						</div>
						<div class="grid gap-3 sm:grid-cols-2">
							@routingChoice("mode", "routing-mode-auto", route.ModeAuto, "Automatic", "Let Jev choose for each task", "branch", v.Draft.Mode == "" || v.Draft.Mode == route.ModeAuto)
							@routingChoice("mode", "routing-mode-fixed", route.ModeFixed, "Use one model", "Send every auto request to your choice", "play", v.Draft.Mode == route.ModeFixed)
						</div>
						<div class="routing-fixed mt-5 rounded-lg border border-line bg-canvas p-4">
							<div class="mb-2 flex items-center gap-2">
								<label for="routing-fixed-model" class="text-[13px] font-medium">Fixed model</label>
								@routingHelp("routing-fixed-help", "Fixed model", "There is no automatic fallback in this mode. Requests fail if the chosen model is unavailable or cannot handle their images. This setting only applies to auto requests.")
							</div>
							<select id="routing-fixed-model" name="fixed_model" class="h-11 w-full rounded-lg border border-line bg-surface pr-8 pl-3 text-[13px]" aria-describedby="routing-fixed-help">
								<option value="">Choose a model</option>
								for _, candidate := range v.Candidates {
									<option value={ candidate.ID } selected?={ v.Draft.FixedModel == candidate.ID }>{ routingModelName(candidate.ID) }</option>
								}
							</select>
						</div>
					</section>
					<section class="routing-auto rounded-xl border border-line bg-surface p-5 sm:p-6" aria-labelledby="routing-priority-title">
						<div class="mb-2 flex items-center gap-2">
							<span class="grid size-6 place-items-center rounded-full bg-raised text-xs text-fg-3">2</span>
							<h2 id="routing-priority-title" class="font-semibold">What matters most?</h2>
							@routingHelp("routing-priority-help", "Priority", "This guides new decisions among suitable models. Quality favors stronger task fit; speed uses supplied latency estimates; cost favors economical choices. Existing thread pins keep their model and reasoning.")
						</div>
						<p class="mb-4 text-[13px] text-fg-3">Keep the normal policy or choose a priority.</p>
						<div class="grid gap-3 sm:grid-cols-2">
							@routingChoice("priority", "routing-priority-auto", decide.PriorityAuto, "Let Jev decide", "Balance the task and expected cost", "spark", v.Draft.Preferences.Priority == "" || v.Draft.Preferences.Priority == decide.PriorityAuto)
							@routingChoice("priority", "routing-priority-quality", decide.PriorityQuality, "Prefer quality", "Give stronger task fit more weight", "check", v.Draft.Preferences.Priority == decide.PriorityQuality)
							@routingChoice("priority", "routing-priority-speed", decide.PrioritySpeed, "Prefer speed", "Favor faster suitable models", "gauge", v.Draft.Preferences.Priority == decide.PrioritySpeed)
							@routingChoice("priority", "routing-priority-cost", decide.PriorityCost, "Prefer cost", "Favor economical suitable models", "key", v.Draft.Preferences.Priority == decide.PriorityCost)
						</div>
					</section>
					<section class="routing-auto rounded-xl border border-line bg-surface p-5 sm:p-6" aria-labelledby="routing-models-title">
						<div class="mb-2 flex items-center gap-2">
							<span class="grid size-6 place-items-center rounded-full bg-raised text-xs text-fg-3">3</span>
							<h2 id="routing-models-title" class="font-semibold">Enabled models & preferences</h2>
							@routingHelp("routing-group-help", "Enabled models", "Enable at least one model. Disabled models are excluded from automatic routing, including fallback and concurrency spill. Existing pins on a disabled model move to an enabled compatible model on their next request. Fixed mode has its own model choice.")
						</div>
						<p class="mb-4 text-[13px] text-fg-3">Turn models on or off. Set a preferred order without typing model IDs.</p>
						<div class="mb-3 flex items-center justify-end gap-2 text-xs text-fg-3">
							<span>Preference is optional</span>
							@routingHelp("routing-ranking-help", "Model preference", "1 is your highest preference. Give each ranked model a different position. Jev uses this order to break ties after task fit and priority. No preference keeps the normal policy; disabled models are skipped regardless of preference.")
						</div>
						<div class="space-y-3">
							for i, candidate := range v.Candidates {
								<div class="routing-model rounded-lg border border-line bg-canvas p-4">
									<div class="flex flex-wrap items-center gap-3 sm:flex-nowrap">
										<label class="flex min-w-0 flex-1 cursor-pointer items-center gap-3" for={ "routing-enabled-" + strconv.Itoa(i) }>
											<input id={ "routing-enabled-" + strconv.Itoa(i) } type="checkbox" role="switch" name="models" value={ candidate.ID } checked?={ slices.Contains(v.Draft.Models, candidate.ID) } class="routing-switch shrink-0" aria-describedby="routing-group-help"/>
											<span class="min-w-0">
												<span class="block text-[13px] font-semibold">{ routingModelName(candidate.ID) }</span>
												<span class="block truncate font-mono text-[11px] text-fg-3">{ candidate.ID }</span>
											</span>
										</label>
										if candidate.Description != "" {
											@routingHelp("routing-model-help-"+strconv.Itoa(i), "About "+routingModelName(candidate.ID), candidate.Description)
										}
										<div class="ml-auto w-full sm:w-36">
											<label for={ "routing-rank-" + strconv.Itoa(i) } class="sr-only">{ "Preference for " + routingModelName(candidate.ID) }</label>
											<select id={ "routing-rank-" + strconv.Itoa(i) } name={ "rank:" + candidate.ID } class="h-10 w-full rounded-lg border border-line bg-surface pr-8 pl-3 text-xs" aria-describedby="routing-ranking-help">
												<option value="">No preference</option>
												for rank := range len(v.Candidates) {
													<option value={ strconv.Itoa(rank + 1) } selected?={ v.Ranks[candidate.ID] == strconv.Itoa(rank + 1) }>{ routingRankLabel(rank + 1) }</option>
												}
											</select>
										</div>
									</div>
									<p class="routing-disabled mt-3 text-xs text-fg-3">Disabled for automatic routing</p>
								</div>
							}
						</div>
						if v.SolHigh {
							<p class="mt-4 text-xs text-fg-3">GPT-6.1 Sol keeps its configured high reasoning effort.</p>
						}
					</section>
					<details class="routing-auto rounded-xl border border-line bg-surface p-5">
						<summary class="cursor-pointer text-[13px] font-medium text-fg-2">Advanced options</summary>
						<div class="mt-4 flex items-center gap-3">
							<label class="flex flex-1 cursor-pointer items-center gap-3">
								<input type="checkbox" name="jev_enabled" value="true" checked?={ v.Draft.JevEnabled } class="size-4 accent-fg"/>
								<span class="text-[13px]">Enable Jev</span>
							</label>
							@routingHelp("routing-jev-help", "Enable Jev", "Keep this enabled for the normal automatic policy. Turning it off skips Jev but leaves other configured deciders available. Use one model bypasses every decider.")
						</div>
					</details>
					<div class="sticky bottom-3 z-10 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-surface p-4 shadow-lg">
						<div class="flex items-center gap-2">
							<button type="submit" name="reset" value="full_auto" formnovalidate class="h-10 rounded-lg border border-line px-4 text-[13px] font-medium hover:bg-raised">Full auto</button>
							@routingHelp("routing-reset-help", "Full auto", "Immediately saves the normal automatic policy: enables Jev and all configured models, and clears the fixed model, priority and model ranking. Existing automatic pins are retained. Requests already running keep their current route.")
						</div>
						<button type="submit" class="flex h-10 items-center gap-2 rounded-lg bg-fg px-5 text-[13px] font-semibold text-canvas hover:opacity-90 disabled:opacity-40">@icon("check", "size-4")
Save settings</button>
					</div>
				</fieldset>
			</form>
			<aside class="min-w-0 rounded-xl border border-line bg-surface p-5 xl:sticky xl:top-5" aria-labelledby="routing-active-title">
				<h2 id="routing-active-title" class="font-semibold">Active settings</h2>
				<p class="mt-1 text-xs text-fg-3">Your saved configuration</p>
				if v.Available {
					<dl class="mt-5 space-y-4 text-[13px]">
						<div>
							<dt class="text-xs text-fg-3">Mode</dt>
							<dd class="mt-1 font-medium">
								if v.Current.Mode == route.ModeFixed {
									Fixed model
								} else {
									Automatic
								}
							</dd>
						</div>
						if v.Current.Mode == route.ModeFixed {
							<div><dt class="text-xs text-fg-3">Requests go to</dt><dd class="mt-1 break-all font-mono text-xs">{ v.Current.FixedModel }</dd></div>
							<p class="text-xs text-fg-3">All deciders are bypassed while fixed mode is active.</p>
						} else {
							<div><dt class="text-xs text-fg-3">Enabled models</dt><dd class="mt-1 break-words font-mono text-xs">{ v.groupLabel() }</dd></div>
							<div>
								<dt class="text-xs text-fg-3">Jev</dt>
								<dd class="mt-1">
									if v.Current.JevEnabled {
										Enabled
									} else {
										Disabled; other deciders remain available
									}
								</dd>
							</div>
							<div><dt class="text-xs text-fg-3">Priority</dt><dd class="mt-1 font-medium">{ v.priorityLabel() }</dd></div>
							if len(v.Current.Preferences.Ranking) > 0 {
								<div><dt class="text-xs text-fg-3">Model preference</dt><dd class="mt-1 break-all text-xs">{ strings.Join(v.Current.Preferences.Ranking, " → ") }</dd></div>
							}
						}
					</dl>
				} else {
					<p class="mt-3 text-xs text-fg-3">Changes are disabled until the active settings can be read.</p>
				}
				<p class="mt-5 border-t border-line pt-4 text-xs leading-relaxed text-fg-3">Changes take effect after saving and are saved across router restarts. Requests already running keep their current route.</p>
			</aside>
		</div>
	}
}

templ routingChoice(name, id, value, title, description, glyph string, selected bool) {
	<label for={ id } class="block cursor-pointer">
		<input id={ id } type="radio" name={ name } value={ value } checked?={ selected } class="peer sr-only"/>
		<span class="flex h-full items-center gap-3 rounded-lg border border-line bg-canvas p-4 peer-checked:border-fg-3 peer-checked:bg-raised peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-fg-3 hover:border-line-strong">
			@icon(glyph, "size-5 text-fg-2")
			<span class="flex-1"><span class="block text-[13px] font-semibold">{ title }</span><span class="mt-1 block text-xs leading-relaxed text-fg-3">{ description }</span></span>
			<span class="routing-choice-dot size-3.5 shrink-0 rounded-full border border-line-strong"></span>
		</span>
	</label>
}

templ routingHelp(id, label, text string) {
	<span class="routing-help relative inline-flex shrink-0" data-on:mouseenter="evt.currentTarget.classList.remove('routing-help-dismissed')" data-on:focusin="evt.currentTarget.classList.remove('routing-help-dismissed')">
		<button type="button" class="grid size-7 place-items-center rounded-full text-fg-3 hover:bg-raised hover:text-fg" aria-label={ "Help: " + label } aria-describedby={ id } data-on:keydown="if (evt.key === 'Escape') { evt.currentTarget.parentElement.classList.add('routing-help-dismissed'); evt.currentTarget.blur() }">
			@icon("question", "size-4")
		</button>
		<span id={ id } role="tooltip" class="routing-tip z-30 rounded-lg border border-line-strong bg-raised p-3 text-xs leading-relaxed font-normal text-fg-2 shadow-xl"><span class="mb-1 block font-semibold text-fg">{ label }</span>{ text }</span>
	</span>
}
