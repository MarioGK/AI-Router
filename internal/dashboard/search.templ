package dashboard

import "github.com/MarioGK/AI-Router/internal/pin"

templ promptSearch(id, value, apply, clear string) {
	<div class="flex flex-wrap items-center gap-1.5">
		<label for={ id } class="sr-only">Search prompt text</label>
		<div class="relative">
			<input id={ id } type="search" value={ value } maxlength={ pin.MaxSearchChars } placeholder="Search prompt text…" data-bind="searchDraft" data-on:input__debounce.300ms={ apply } data-indicator="_loading" class="h-8 w-56 max-w-full rounded-md border border-line bg-canvas pr-8 pl-3 text-[13px] placeholder:text-fg-3"/>
			<button type="button" aria-label="Clear prompt search" data-on:click={ clear } data-show="$searchDraft !== ''" class="absolute top-0 right-0 grid size-8 place-items-center text-fg-3 hover:text-fg">@icon("x", "size-3.5")</button>
		</div>
		@routingHelp(id+"-help", "Prompt search", "Matches all entered words, ignoring case, accents and punctuation, in the recorded first prompt or classifier input. Logs shows requests from matching threads. Later conversation messages and prompts removed by retention cannot be searched.")
	</div>
}
